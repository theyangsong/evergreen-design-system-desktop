{
  "$description": "Motion semantic — 角色变量、属性束、预设 transition、utility 类。单独引用：@eds/desktop-tokens/motion/semantic（变量）或 /motion/utilities（类，需先引 semantic）",
  "groups": [
    {
      "comment": "Duration Roles（语义时长 → base）",
      "tokens": [
        { "name": "motion-duration-instant", "value": "var(--eds-motion-0)", "comment": "Focus / selected / reduced" },
        { "name": "motion-duration-micro", "value": "var(--eds-motion-1)", "comment": "Checkbox / toggle" },
        { "name": "motion-duration-fade", "value": "var(--eds-motion-2)", "comment": "Opacity / 虚线" },
        { "name": "motion-duration-enter", "value": "var(--eds-motion-3)", "comment": "浮层进入" },
        { "name": "motion-duration-hover", "value": "var(--eds-motion-4)", "comment": "Hover / 反馈（默认）" },
        { "name": "motion-duration-shift", "value": "var(--eds-motion-4)", "comment": "Layout / Skid / 宽度" },
        { "name": "motion-duration-emphasis", "value": "var(--eds-motion-5)", "comment": "强调 / 大面板" },
        { "name": "motion-duration-control", "value": "var(--eds-motion-8)", "comment": "Toggle / Tab 滑块" },
        { "name": "motion-duration-feedback", "value": "var(--eds-motion-9)", "comment": "EndFeedback 圆环弹入" },
        { "name": "motion-duration-scroll-fade", "value": "var(--eds-motion-6)", "comment": "Nav 滚动遮罩渐隐" },
        { "name": "motion-duration-spin", "value": "var(--eds-motion-10)", "comment": "Button loading spinner" },
        { "name": "motion-duration-spin-slow", "value": "var(--eds-motion-11)", "comment": "DataList / BatchBar spinner" },
        { "name": "motion-delay-feedback-tick", "value": "var(--eds-motion-3)", "comment": "EndFeedback 勾号延迟" }
      ]
    },
    {
      "comment": "Easing Roles（语义缓动 → base）",
      "tokens": [
        { "name": "motion-easing-standard", "value": "var(--eds-motion-ease-1)", "comment": "缓入缓出（默认）" },
        { "name": "motion-easing-enter", "value": "var(--eds-motion-ease-2)", "comment": "进入" },
        { "name": "motion-easing-exit", "value": "var(--eds-motion-ease-3)", "comment": "离开" },
        { "name": "motion-easing-product", "value": "var(--eds-motion-ease-4)", "comment": "Material" },
        { "name": "motion-easing-linear", "value": "var(--eds-motion-ease-5)", "comment": "Spinner 线性" },
        { "name": "motion-easing-spring", "value": "var(--eds-motion-ease-6)", "comment": "弹性反馈（圆环）" },
        { "name": "motion-easing-spring-emphasis", "value": "var(--eds-motion-ease-7)", "comment": "弹性反馈（勾号）" },
        { "name": "motion-easing-decelerate", "value": "var(--eds-motion-ease-8)", "comment": "减速渐隐" }
      ]
    },
    {
      "comment": "Property Bundles（属性束 — 在 CSS Modules 里自行拼 transition）",
      "tokens": [
        {
          "name": "motion-property-paint",
          "value": "background-color, color, border-color, box-shadow, opacity, outline-color, outline-offset",
          "comment": "配合 duration + easing 单独使用"
        },
        {
          "name": "motion-property-geometry",
          "value": "flex, max-width, width, min-width, max-height, transform, left, padding",
          "comment": "Layout / Skid / max-height 位移属性束"
        },
        {
          "name": "motion-property-fade",
          "value": "opacity",
          "comment": "仅透明度"
        }
      ]
    },
    {
      "comment": "Preset Transitions（预设 transition 串 — 单独 var() 或组合）",
      "tokens": [
        {
          "name": "motion-transition-hover",
          "value": "background-color var(--motion-duration-hover) var(--motion-easing-standard), color var(--motion-duration-hover) var(--motion-easing-standard), border-color var(--motion-duration-hover) var(--motion-easing-standard), box-shadow var(--motion-duration-hover) var(--motion-easing-standard), opacity var(--motion-duration-hover) var(--motion-easing-standard), outline-color var(--motion-duration-hover) var(--motion-easing-standard), outline-offset var(--motion-duration-hover) var(--motion-easing-standard)",
          "comment": "Paint · layer-hover"
        },
        {
          "name": "motion-transition-shift",
          "value": "flex var(--motion-duration-shift) var(--motion-easing-standard), max-width var(--motion-duration-shift) var(--motion-easing-standard), width var(--motion-duration-shift) var(--motion-easing-standard), min-width var(--motion-duration-shift) var(--motion-easing-standard), max-height var(--motion-duration-shift) var(--motion-easing-standard), transform var(--motion-duration-shift) var(--motion-easing-standard), left var(--motion-duration-shift) var(--motion-easing-standard), padding var(--motion-duration-shift) var(--motion-easing-standard)",
          "comment": "Geometry · layer-shift"
        },
        {
          "name": "motion-transition-control",
          "value": "transform var(--motion-duration-control) var(--motion-easing-product), width var(--motion-duration-control) var(--motion-easing-product)",
          "comment": "Toggle 滑块 / Tab 指示器"
        },
        {
          "name": "motion-transition-scroll-fade",
          "value": "opacity var(--motion-duration-scroll-fade) var(--motion-easing-decelerate)",
          "comment": "Nav 滚动区域遮罩"
        },
        {
          "name": "motion-transition-float",
          "value": "opacity var(--motion-duration-hover) var(--motion-easing-standard), transform var(--motion-duration-hover) var(--motion-easing-standard)",
          "comment": "浮条进出场（DataList operation bar）"
        },
        {
          "name": "motion-transition-stat-width",
          "value": "width var(--motion-duration-shift) var(--motion-easing-exit)",
          "comment": "BatchBar 统计数字宽度"
        },
        {
          "name": "motion-transition-fade",
          "value": "opacity var(--motion-duration-fade) var(--motion-easing-standard)",
          "comment": "Opacity · layer-fade"
        },
        {
          "name": "motion-transition-enter",
          "value": "opacity var(--motion-duration-enter) var(--motion-easing-enter), transform var(--motion-duration-enter) var(--motion-easing-enter)",
          "comment": "Overlay enter · layer-enter"
        }
      ]
    }
  ],
  "reducedMotionOverrides": [
    { "name": "motion-duration-micro", "value": "var(--eds-motion-0)" },
    { "name": "motion-duration-fade", "value": "var(--eds-motion-0)" },
    { "name": "motion-duration-enter", "value": "var(--eds-motion-0)" },
    { "name": "motion-duration-hover", "value": "var(--eds-motion-0)" },
    { "name": "motion-duration-shift", "value": "var(--eds-motion-0)" },
    { "name": "motion-duration-emphasis", "value": "var(--eds-motion-0)" },
    { "name": "motion-duration-control", "value": "var(--eds-motion-0)" },
    { "name": "motion-duration-feedback", "value": "var(--eds-motion-0)" },
    { "name": "motion-duration-scroll-fade", "value": "var(--eds-motion-0)" },
    { "name": "motion-duration-spin", "value": "var(--eds-motion-0)" },
    { "name": "motion-duration-spin-slow", "value": "var(--eds-motion-0)" },
    { "name": "motion-delay-feedback-tick", "value": "var(--eds-motion-0)" }
  ],
  "composeHost": {
    "className": "motion-compose",
    "title": "Compose Host — 组合多个 motion 层（与 motion-hover / shift / fade / enter 叠用）",
    "layers": [
      { "modifier": "motion-hover", "layerVar": "motion-layer-hover", "presetVar": "motion-transition-hover" },
      { "modifier": "motion-shift", "layerVar": "motion-layer-shift", "presetVar": "motion-transition-shift" },
      { "modifier": "motion-fade", "layerVar": "motion-layer-fade", "presetVar": "motion-transition-fade" },
      { "modifier": "motion-enter", "layerVar": "motion-layer-enter", "presetVar": "motion-transition-enter" }
    ],
    "notes": [
      "用法：class=\"motion-compose motion-hover motion-fade\"",
      "未加 motion-compose 时，各 utility 仍为独立完整 transition"
    ]
  },
  "presetCombos": [
    {
      "className": "motion-interactive",
      "title": "Interactive — Hover + Fade（地址行 + 虚线）",
      "transition": "var(--motion-transition-hover), var(--motion-transition-fade)",
      "composeLayers": ["motion-layer-hover", "motion-layer-fade"],
      "composePresets": ["motion-transition-hover", "motion-transition-fade"],
      "notes": ["单独：等价 transition 两预设；组合：motion-compose motion-interactive"]
    },
    {
      "className": "motion-layout",
      "title": "Layout — Shift + Fade（侧栏 + 渐隐）",
      "transition": "var(--motion-transition-shift), var(--motion-transition-fade)",
      "composeLayers": ["motion-layer-shift", "motion-layer-fade"],
      "composePresets": ["motion-transition-shift", "motion-transition-fade"],
      "notes": ["Skid / 宽度动画 + opacity"]
    }
  ],
  "utilityClasses": [
    {
      "title": "Hover — 交互反馈（单独使用）",
      "className": "motion-hover",
      "standaloneTransition": "var(--motion-transition-hover)",
      "composeLayer": "motion-layer-hover",
      "composePreset": "motion-transition-hover",
      "notes": ["Button / Nav / Link · Focus 时换 .motion-none"]
    },
    {
      "title": "Shift — 位移 / 布局（单独使用）",
      "className": "motion-shift",
      "standaloneTransition": "var(--motion-transition-shift)",
      "composeLayer": "motion-layer-shift",
      "composePreset": "motion-transition-shift",
      "notes": ["Layout Skid / Input 宽度"]
    },
    {
      "title": "Fade — 透明度（单独使用）",
      "className": "motion-fade",
      "standaloneTransition": "var(--motion-transition-fade)",
      "composeLayer": "motion-layer-fade",
      "composePreset": "motion-transition-fade",
      "notes": ["Tooltip 虚线 / 渐隐"]
    },
    {
      "title": "Enter — 浮层进入（单独使用）",
      "className": "motion-enter",
      "standaloneTransition": "var(--motion-transition-enter)",
      "composeLayer": "motion-layer-enter",
      "composePreset": "motion-transition-enter",
      "notes": ["Dropdown / Popover"]
    },
    {
      "title": "None — 无过渡",
      "className": "motion-none",
      "standaloneTransition": "none",
      "notes": ["Focus / Selected · 覆盖 hover"]
    }
  ]
}
