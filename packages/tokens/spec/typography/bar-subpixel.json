{
  "$description": "Bar (11px) subpixel rendering — 2× font-size + scale(0.5) to bypass browser minimum font size.",
  "className": "eds-bar-text-subpixel",
  "properties": {
    "display": "inline-block",
    "box-sizing": "border-box",
    "font-family": "var(--eds-family-sans)",
    "font-size": "calc(var(--eds-bar-size) * 2)",
    "font-weight": "var(--eds-bar-weight)",
    "line-height": "calc(var(--eds-bar-line-height) * 2)",
    "transform": "scale(0.5)",
    "transform-origin": "top center",
    "margin-bottom": "calc(var(--eds-bar-line-height) * -1)",
    "-webkit-font-smoothing": "antialiased",
    "-moz-osx-font-smoothing": "grayscale"
  }
}
