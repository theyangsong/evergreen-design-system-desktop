{
  "$description": "Text Styles (Figma Text Styles) — class names bundle typography semantic tokens (size + weight + line-height). Built to dist/css/text/styles.css.",
  "styles": [
    {
      "title": "Display",
      "className": "typography-display",
      "properties": {
        "font-size": "var(--eds-display-size)",
        "font-weight": "var(--eds-display-weight)",
        "line-height": "var(--eds-display-line-height)"
      }
    },
    {
      "title": "Headline",
      "className": "typography-headline",
      "properties": {
        "font-size": "var(--eds-headline-size)",
        "font-weight": "var(--eds-headline-weight)",
        "line-height": "var(--eds-headline-line-height)"
      }
    },
    {
      "title": "Title",
      "className": "typography-title",
      "properties": {
        "font-size": "var(--eds-title-size)",
        "font-weight": "var(--eds-title-weight)",
        "line-height": "var(--eds-title-line-height)"
      }
    },
    {
      "title": "Body Large",
      "className": "typography-body-large",
      "properties": {
        "font-size": "var(--eds-body-large-size)",
        "font-weight": "var(--eds-body-large-weight)",
        "line-height": "var(--eds-body-large-line-height)"
      }
    },
    {
      "title": "Body Large Strong",
      "className": "typography-body-large-strong",
      "properties": {
        "font-size": "var(--eds-body-large-strong-size)",
        "font-weight": "var(--eds-body-large-strong-weight)",
        "line-height": "var(--eds-body-large-strong-line-height)"
      }
    },
    {
      "title": "Body Medium",
      "className": "typography-body-medium",
      "properties": {
        "font-size": "var(--eds-body-medium-size)",
        "font-weight": "var(--eds-body-medium-weight)",
        "line-height": "var(--eds-body-medium-line-height)"
      }
    },
    {
      "title": "Body Medium Strong",
      "className": "typography-body-medium-strong",
      "properties": {
        "font-size": "var(--eds-body-medium-strong-size)",
        "font-weight": "var(--eds-body-medium-strong-weight)",
        "line-height": "var(--eds-body-medium-strong-line-height)"
      }
    },
    {
      "title": "Body Small",
      "className": "typography-body-small",
      "properties": {
        "font-size": "var(--eds-body-small-size)",
        "font-weight": "var(--eds-body-small-weight)",
        "line-height": "var(--eds-body-small-line-height)"
      }
    },
    {
      "title": "Body Small Strong",
      "className": "typography-body-small-strong",
      "properties": {
        "font-size": "var(--eds-body-small-strong-size)",
        "font-weight": "var(--eds-body-small-strong-weight)",
        "line-height": "var(--eds-body-small-strong-line-height)"
      }
    },
    {
      "title": "Footnote",
      "className": "typography-footnote",
      "properties": {
        "font-size": "var(--eds-footnote-size)",
        "font-weight": "var(--eds-footnote-weight)",
        "line-height": "var(--eds-footnote-line-height)"
      }
    },
    {
      "title": "Footnote Strong",
      "className": "typography-footnote-strong",
      "properties": {
        "font-size": "var(--eds-footnote-strong-size)",
        "font-weight": "var(--eds-footnote-strong-weight)",
        "line-height": "var(--eds-footnote-strong-line-height)"
      }
    },
    {
      "title": "Bar",
      "className": "typography-bar",
      "properties": {
        "display": "inline-block",
        "box-sizing": "border-box",
        "font-family": "var(--eds-family-sans)",
        "font-size": "calc(var(--eds-bar-size) * 2)",
        "font-weight": "var(--eds-bar-weight)",
        "line-height": "calc(var(--eds-bar-line-height) * 2)",
        "transform": "scale(0.5)",
        "transform-origin": "top center",
        "margin-bottom": "calc(var(--eds-bar-line-height) * -1)",
        "-webkit-font-smoothing": "antialiased",
        "-moz-osx-font-smoothing": "grayscale"
      }
    }
  ]
}
