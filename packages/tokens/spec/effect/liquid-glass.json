{
  "$description": "Liquid Glass — SVG feDisplacementMap + backdrop-filter. Based on https://github.com/shuding/liquid-glass (MIT).",
  "$reference": "https://github.com/shuding/liquid-glass",
  "filterPrefix": "eds-liquid-glass",
  "backdrop": {
    "blur": "0.25px",
    "contrast": "1.2",
    "brightness": "1.05",
    "saturate": "1.1"
  },
  "surface": {
    "background": "color(var(--eds-face) / .72)"
  },
  "shader": {
    "edgeStart": 0.8,
    "edgeEnd": 0,
    "edgeOffset": 0.15,
    "rectInsetX": 0.2,
    "rectInsetY": 0.15,
    "cornerRadius": 0.6
  },
  "fallback": {
    "backdropFilter": "blur(12px) saturate(180%)",
    "background": "color(var(--eds-face) / .85)"
  }
}
