{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "isolatedModules": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@eds/desktop-components": [
        "../../packages/components"
      ],
      "@eds/desktop-components/*": [
        "../../packages/components/*"
      ],
      "@eds/desktop-animations": [
        "../../packages/animations"
      ],
      "@eds/desktop-animations/*": [
        "../../packages/animations/*"
      ],
      "@eds/desktop-tokens": [
        "../../packages/tokens"
      ],
      "@eds/desktop-tokens/*": [
        "../../packages/tokens/*"
      ]
    },
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue"
  ]
}
