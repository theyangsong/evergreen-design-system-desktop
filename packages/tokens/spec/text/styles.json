{
  "$description": "Text styles referencing typography semantic tokens. Class names match Figma Text Styles.",
  "styles": [
    {
      "title": "Display",
      "className": "typography-display",
      "properties": {
        "font-size": "var(--eds-display-size)",
        "font-weight": "var(--eds-display-weight)",
        "line-height": "var(--eds-display-line-height)"
      }
    },
    {
      "title": "Headline",
      "className": "typography-headline",
      "properties": {
        "font-size": "var(--eds-headline-size)",
        "font-weight": "var(--eds-headline-weight)",
        "line-height": "var(--eds-headline-line-height)"
      }
    },
    {
